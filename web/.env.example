# Copy this file to web/.env. Nothing here is secret: every VITE_ value ends up in the browser.

# Where the API is. Local API: http://localhost:3001. Deployed: the ApiUrl stack output.
VITE_API_URL=http://localhost:3001

# true serves fixtures from src/app/mock/ instead of calling the API.
VITE_USE_MOCKS=false

# true, with VITE_USE_MOCKS=true, serves the populated demo set for the video (src/app/mock/demo.ts).
VITE_MOCK_DEMO=false

# The Google OAuth client id for "Continue with Google" (type "Web application"). It is public.
# Empty hides every sign-in control; guests can still play. Same value as GOOGLE_CLIENT_ID in api/.env.
VITE_GOOGLE_CLIENT_ID=
