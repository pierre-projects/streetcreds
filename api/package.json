{
  "name": "streetcreds-api",
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/local.ts",
    "check": "tsc --noEmit && vitest run --passWithNoTests",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "deploy": "npm run build && sam deploy --template-file template.yaml",
    "build": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=es2022 --outfile=dist/index.js",
    "solana-setup": "tsx --env-file-if-exists=.env scripts/solana-setup.ts",
    "mint-test": "tsx --env-file-if-exists=.env scripts/mint-test.ts",
    "deploy-secrets": "tsx --env-file-if-exists=.env scripts/deploy-secrets.ts",
    "city-records": "tsx scripts/city-records.ts"
  },
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1169.0",
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/lib-dynamodb": "^3.1169.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "@google/genai": "^3.3.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "hono": "^4.13.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.8",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vitest": "^5.1.0"
  },
  "private": true
}
