# Copy this file to api/.env and fill it in. api/.env is git-ignored: never commit it.
# What each value means: docs/TECHNICAL.md section 3.

AWS_REGION=us-east-2

# Table names. These match api/template.yaml.
TABLE_PLAYERS=streetcreds-players
TABLE_REPORTS=streetcreds-reports
TABLE_AWARDS=streetcreds-awards
TABLE_DEAL_UNLOCKS=streetcreds-deal-unlocks
TABLE_DEAL_REDEMPTIONS=streetcreds-deal-redemptions

# From the stack output PhotoBucketName after the first deploy.
PHOTO_BUCKET=

# Every address the web app is served from, comma-separated, no spaces.
WEB_ORIGINS=http://localhost:5173

# SECRET. From Google AI Studio. Sarah has it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# off, per-player or shared. Stay on off until scripts/solana-setup.ts has been run.
SOLANA_MODE=off
# The free public address is rate-limited: it refuses requests after about ten in a row.
# For a busy demo, put a dedicated DEVNET address from a provider here instead. That address
# usually contains an access key, so treat it as a SECRET. Then run  npm run deploy-secrets.
SOLANA_RPC_URL=https://api.devnet.solana.com
# SECRET. Base64 of the treasury key, printed by scripts/solana-setup.ts.
SOLANA_TREASURY_SECRET=
# The mint address printed by scripts/solana-setup.ts.
CIVIC_MINT=
